<?xml version="1.0" encoding="iso-8859-1"?>
<root version="3.0">
	<properties>
		<name>Feature: Pixels Dice</name>
		<version>0.2.0</version>
		<author>zaibach333</author>
		<description>Roll physical Pixels smart dice and have the results count in Fantasy Grounds. Requires the PixelsFGU bridge app.</description>
		<loadorder>60</loadorder>
		<!-- No <ruleset> tags: available in every ruleset. On rulesets without CoreRPG's
		     roll APIs (ActionsManager.roll, ManualRollManager) it switches itself off. -->
	</properties>
	<announcement text="Pixels Dice - type /pixels for status" font="emotefont" />
	<base>
		<includefile source="strings/strings_pixels.xml" />
		<includefile source="xml/manualroll_entry.xml" />
		<script name="PixelsManager" file="scripts/manager_pixels.lua" />
	</base>
</root>
